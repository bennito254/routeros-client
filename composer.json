{
    "name": "bennito254/routeros-client",
    "description": "A modern, production-grade PHP client for MikroTik RouterOS API.",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Bennito254",
            "email": "bennito254@example.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Bennito254\\RouterOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bennito254\\RouterOS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "analyze": "phpstan analyse src"
    },
    "config": {
        "sort-packages": true
    }
}
