{
    "name": "bennito254/routeros-client",
    "description": "A modern, production-grade PHP client for MikroTik RouterOS API.",
    "type": "library",
    "keywords": [
        "mikrotik",
        "routeros",
        "api",
        "client",
        "php",
        "networking",
        "sockets",
        "socks5"
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "suggest": {
        "monolog/monolog": "Allows for robust logging of API requests, responses, and connection handshakes."
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Bennito254",
            "email": "bennito254@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/bennito254/routeros-client/issues",
        "source": "https://github.com/bennito254/routeros-client"
    },
    "autoload": {
        "psr-4": {
            "Bennito254\\RouterOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bennito254\\RouterOS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "analyze": "phpstan analyse src",
        "lint": "phpcs src --standard=PSR12",
        "fix": "phpcbf src --standard=PSR12"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
